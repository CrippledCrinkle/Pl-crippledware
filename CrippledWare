local MainEspSettings = getgenv().MainEspSettings
local MainTracerBeams = {}
local LastMainTargetPlayer = nil

local function RemoveMainTracerBeam(Plr)
	local Data = MainTracerBeams[Plr]
	if Data then
		if Data.Beam then Data.Beam:Destroy() end
		if Data.Start then Data.Start:Destroy() end
		if Data.End then Data.End:Destroy() end
		MainTracerBeams[Plr] = nil
	end
end

local function RemoveAllMainTracerBeams()
	for Plr, _ in pairs(MainTracerBeams) do
		RemoveMainTracerBeam(Plr)
	end
end

local function GetMainCurrentTargetPlayer()
	return nil
end

local function GetMainPlayerTracerColor(Plr)
	if Plr.TeamColor then
		return Plr.TeamColor.Color
	elseif Plr.Team and Plr.Team.TeamColor then
		return Plr.Team.TeamColor.Color
	end
	return MainEspSettings.TracerColor
end

local function UpdateMainTracerBeam(Plr)
	local Char = Plr.Character
	local LocalChar = LocalPlayer.Character
	local LocalHrp = LocalChar and LocalChar:FindFirstChild("HumanoidRootPart")
	local TargetHrp = Char and Char:FindFirstChild("HumanoidRootPart")

	if not Char or not LocalHrp or not TargetHrp then
		RemoveMainTracerBeam(Plr)
		return
	end

	local Data = MainTracerBeams[Plr]
	if Data then
		if Data.Start.Parent ~= LocalHrp or Data.End.Parent ~= TargetHrp then
			RemoveMainTracerBeam(Plr)
			Data = nil
		end
	end

	if not Data then
		local Attachment0 = Instance.new("Attachment")
		Attachment0.Parent = LocalHrp

		local Attachment1 = Instance.new("Attachment")
		Attachment1.Parent = TargetHrp

		local Beam = Instance.new("Beam")
		Beam.Name = "MainTracerBeam"
		Beam.Attachment0 = Attachment0
		Beam.Attachment1 = Attachment1
		Beam.FaceCamera = true
		Beam.Parent = TargetHrp

		Data = {
			Beam = Beam,
			Start = Attachment0,
			End = Attachment1
		}
		MainTracerBeams[Plr] = Data
	end

	local Color = GetMainPlayerTracerColor(Plr)
	Data.Beam.Color = ColorSequence.new(Color)
	Data.Beam.Width0 = MainEspSettings.TracerThickness
	Data.Beam.Width1 = MainEspSettings.TracerThickness
	Data.Beam.Enabled = true
end

local function UpdateAllMainTracerBeams()
	if not MainEspSettings.Enabled or not MainEspSettings.TracerEnabled then
		RemoveAllMainTracerBeams()
		return
	end

	if MainEspSettings.TracerTargetOnly then
		local TargetPlayer = GetMainCurrentTargetPlayer()

		for _, Plr in ipairs(Players:GetPlayers()) do
			if Plr ~= LocalPlayer then
				if Plr == TargetPlayer then
					local Char = Plr.Character
					local Hum = Char and Char:FindFirstChildOfClass("Humanoid")
					if Char and Hum and Hum.Health > 0 then
						UpdateMainTracerBeam(Plr)
					else
						RemoveMainTracerBeam(Plr)
					end
				else
					RemoveMainTracerBeam(Plr)
				end
			end
		end
		return
	end

	for _, Plr in ipairs(Players:GetPlayers()) do
		if Plr ~= LocalPlayer then
			local Char = Plr.Character
			local Hum = Char and Char:FindFirstChildOfClass("Humanoid")
			if Char and Hum and Hum.Health > 0 then
				UpdateMainTracerBeam(Plr)
			else
				RemoveMainTracerBeam(Plr)
			end
		end
	end

	for Plr, _ in pairs(MainTracerBeams) do
		if not Plr.Parent or Plr == LocalPlayer then
			RemoveMainTracerBeam(Plr)
		end
	end
end

local function ResetAllMainHighlights()
	for _, Plr in ipairs(Players:GetPlayers()) do
		if Plr ~= LocalPlayer and Plr.Character then
			local Highlight = Plr.Character:FindFirstChild("MainEspHighlight")
			if Highlight and Highlight:IsA("Highlight") then
				local TeamColor = Color3.fromRGB(255, 0, 0)
				if Plr.TeamColor then TeamColor = Plr.TeamColor.Color
				elseif Plr.Team and Plr.Team.TeamColor then TeamColor = Plr.Team.TeamColor.Color end

				Highlight.FillColor = TeamColor
				Highlight.OutlineColor = TeamColor
				Highlight.FillTransparency = 0.85
				Highlight.OutlineTransparency = 0
			end

			local Head = Plr.Character:FindFirstChild("Head")
			if Head then
				local Billboard = Head:FindFirstChild("MainEspNameTag")
				if Billboard then
					local Label = Billboard:FindFirstChild("NameLabel") or Billboard:FindFirstChildOfClass("TextLabel")
					if Label then
						Label.TextColor3 = MainEspSettings.TextColor or Color3.fromRGB(255, 255, 255)
						Label.TextSize = MainEspSettings.NameTextSize or 12
						Label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
					end
				end
			end
		end
	end
end

local function HighlightMainTarget(TargetPlayer)
	if not TargetPlayer or not TargetPlayer.Character then return end

	local TargetColor = MainEspSettings.TargetColor or Color3.fromRGB(255, 182, 255)

	local Highlight = TargetPlayer.Character:FindFirstChild("MainEspHighlight")
	if Highlight and Highlight:IsA("Highlight") then
		Highlight.FillColor = TargetColor
		Highlight.OutlineColor = TargetColor
		Highlight.FillTransparency = 0.65
		Highlight.OutlineTransparency = 0
	end
end

local function EnsureMainTargetNameTag(Head)
	local Billboard = Head:FindFirstChild("MainEspTargetNameTag")
	if not Billboard then
		Billboard = Instance.new("BillboardGui")
		Billboard.Name = "MainEspTargetNameTag"
		Billboard.Size = UDim2.new(0, 200, 0, 30)
		Billboard.StudsOffset = Vector3.new(0, 1.5, 0)
		Billboard.AlwaysOnTop = true
		Billboard.Parent = Head

		local Label = Instance.new("TextLabel")
		Label.Name = "TargetLabel"
		Label.BackgroundTransparency = 1
		Label.Size = UDim2.new(1, 0, 1, 0)
		Label.Text = MainEspSettings.TargetCustomText or "Target"
		Label.Font = Enum.Font.GothamBold
		Label.TextStrokeTransparency = 0
		Label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
		Label.Parent = Billboard
	end
	return Billboard
end

local function UpdateMainTargetNameTag(TargetPlayer)
	if LastMainTargetPlayer and LastMainTargetPlayer ~= TargetPlayer and LastMainTargetPlayer.Character then
		local OldHead = LastMainTargetPlayer.Character:FindFirstChild("Head")
		if OldHead then
			local OldBillboard = OldHead:FindFirstChild("MainEspTargetNameTag")
			if OldBillboard then OldBillboard:Destroy() end
		end
	end

	if not TargetPlayer or not TargetPlayer.Character then return end
	local Head = TargetPlayer.Character:FindFirstChild("Head")
	if not Head then return end

	if MainEspSettings.TargetNameEnabled then
		local Billboard = EnsureMainTargetNameTag(Head)
		local Label = Billboard:FindFirstChild("TargetLabel")
		if Label then
			Label.TextColor3 = MainEspSettings.TargetTextColor or Color3.fromRGB(255, 182, 255)
			Label.TextSize = MainEspSettings.TargetNameTextSize or 12
			Label.Text = MainEspSettings.TargetCustomText or "Target"
		end
	else
		local Billboard = Head:FindFirstChild("MainEspTargetNameTag")
		if Billboard then Billboard:Destroy() end
	end
end

local function UpdateMainEspSync()
	if not MainEspSettings.Enabled then return end

	ResetAllMainHighlights()

	local TargetPlayer = GetMainCurrentTargetPlayer()

	if TargetPlayer and TargetPlayer.Character then
		HighlightMainTarget(TargetPlayer)
	end

	UpdateMainTargetNameTag(TargetPlayer)

	LastMainTargetPlayer = TargetPlayer
end

local function ApplyMainEsp(Plr)
	if Plr == LocalPlayer then return end
	local Char = Plr.Character
	if not Char then return end

	local Humanoid = Char:FindFirstChildOfClass("Humanoid")
	if not Humanoid or Humanoid.Health <= 0 then return end

	local TeamColor = Color3.fromRGB(255, 0, 0)
	if Plr.TeamColor then TeamColor = Plr.TeamColor.Color
	elseif Plr.Team and Plr.Team.TeamColor then TeamColor = Plr.Team.TeamColor.Color end

	local Highlight = Char:FindFirstChild("MainEspHighlight")
	if not Highlight then
		Highlight = Instance.new("Highlight", Char)
		Highlight.Name = "MainEspHighlight"
	end
	Highlight.FillColor = TeamColor
	Highlight.FillTransparency = 0.85
	Highlight.OutlineColor = TeamColor
	Highlight.OutlineTransparency = 0

	local Head = Char:FindFirstChild("Head")
	if Head then
		local Billboard = Head:FindFirstChild("MainEspNameTag")
		if not MainEspSettings.NamesEnabled then
			if Billboard then Billboard:Destroy() end
		elseif not Billboard then
			Billboard = Instance.new("BillboardGui", Head)
			Billboard.Name = "MainEspNameTag"
			Billboard.Size = UDim2.new(0, 200, 0, 30)
			Billboard.StudsOffset = Vector3.new(0, 2.5, 0)
			Billboard.AlwaysOnTop = true
			local Label = Instance.new("TextLabel", Billboard)
			Label.Name = "NameLabel"
			Label.BackgroundTransparency = 1
			Label.Size = UDim2.new(1, 0, 1, 0)
			Label.Text = Plr.DisplayName .. " (@" .. Plr.Name .. ")"
			Label.TextColor3 = MainEspSettings.TextColor or Color3.fromRGB(255, 255, 255)
			Label.Font = Enum.Font.GothamBold
			Label.TextSize = MainEspSettings.NameTextSize or 12
			Label.TextStrokeTransparency = 0
			Label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
		end
	end
end

local function RemoveMainEsp(Plr)
	if Plr.Character then
		local Highlight = Plr.Character:FindFirstChild("MainEspHighlight")
		if Highlight then Highlight:Destroy() end
		local Head = Plr.Character:FindFirstChild("Head")
		if Head then
			local Billboard = Head:FindFirstChild("MainEspNameTag")
			if Billboard then Billboard:Destroy() end
			local TargetBillboard = Head:FindFirstChild("MainEspTargetNameTag")
			if TargetBillboard then TargetBillboard:Destroy() end
		end
	end
	RemoveMainTracerBeam(Plr)
end

local function UpdateMainEsp()
	if not MainEspSettings.Enabled then
		for _, Plr in ipairs(Players:GetPlayers()) do
			if Plr ~= LocalPlayer then RemoveMainEsp(Plr) end
		end
		return
	end
	for _, Plr in ipairs(Players:GetPlayers()) do
