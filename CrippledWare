-- Tracer beam update loop
RunService.RenderStepped:Connect(function()
	if EspState.TracerEnabled and EspState.Enabled then
		for _, Plr in ipairs(Players:GetPlayers()) do
			if Plr ~= LocalPlayer and Plr.Character then
				local IsTeammate = EspState.TeamCheck and Plr.Team == LocalPlayer.Team
				if not IsTeammate then
					if EspState.TracerBeams[Plr] then
						local Data = EspState.TracerBeams[Plr]
						local PlayerHRP = Plr.Character:FindFirstChild("HumanoidRootPart")
						local LocalHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
						
						if not PlayerHRP or not LocalHRP then
							RemoveTracerBeam(Plr)
						end
					else
						CreateTracerBeam(Plr)
					end
				end
			end
		end
	end
end)

