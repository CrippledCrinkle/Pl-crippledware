local EspBox = Tabs.Visuals:AddLeftGroupbox("ESP", "eye")

local EspState = {
	Enabled = false,
	Highlights = {},
	EspNames = {},
	NamesEnabled = true,
	TracerBeams = {},
	TracerEnabled = false,
	TeamCheck = true
}

local EspConfig = {
	PlayerTag = "Player",
	EnemyColor = Color3.fromRGB(255, 60, 60),
	PlayerColor = Color3.fromRGB(80, 150, 255),
	OutlineColor = Color3.fromRGB(255, 255, 255),
	FillTransparency = 0.5,
	OutlineTransparency = 0,
	TracerColor = Color3.fromRGB(255, 255, 255),
	TracerThickness = 0.15
}

local function CreateHighlight(Instance, FillColor)
	if EspState.Highlights[Instance] then return end
	local Highlight = Instance.new("Highlight")
	Highlight.FillColor = FillColor
	Highlight.OutlineColor = EspConfig.OutlineColor
	Highlight.FillTransparency = EspConfig.FillTransparency
	Highlight.OutlineTransparency = EspConfig.OutlineTransparency
	Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	Highlight.Parent = Instance
	EspState.Highlights[Instance] = Highlight
end

local function RemoveHighlight(Instance)
	local Highlight = EspState.Highlights[Instance]
	if Highlight then
		Highlight:Destroy()
		EspState.Highlights[Instance] = nil
	end
end

local function CreateEspName(Character, PlayerName)
	if EspState.EspNames[Character] then return end
	local HRP = Character:FindFirstChild("HumanoidRootPart")
	if not HRP then return end
	
	local BillboardGui = Instance.new("BillboardGui")
	BillboardGui.Adornee = HRP
	BillboardGui.Size = UDim2.fromOffset(100, 50)
	BillboardGui.MaxDistance = 500
	BillboardGui.Parent = HRP
	
	local TextLabel = Instance.new("TextLabel")
	TextLabel.BackgroundTransparency = 1
	TextLabel.Size = UDim2.fromScale(1, 1)
	TextLabel.Text = PlayerName
	TextLabel.TextColor3 = EspConfig.PlayerColor
	TextLabel.TextScaled = true
	TextLabel.Font = Enum.Font.GothamBold
	TextLabel.Parent = BillboardGui
	
	EspState.EspNames[Character] = BillboardGui
end

local function RemoveEspName(Character)
	local Billboard = EspState.EspNames[Character]
	if Billboard then
		Billboard:Destroy()
		EspState.EspNames[Character] = nil
	end
end

local function CreateTracerBeam(Plr)
	if EspState.TracerBeams[Plr] then return end
	local PlayerChar = Plr.Character
	local LocalChar = LocalPlayer.Character
	if not PlayerChar or not LocalChar then return end
	
	local PlayerHRP = PlayerChar:FindFirstChild("HumanoidRootPart")
	local LocalHRP = LocalChar:FindFirstChild("HumanoidRootPart")
	if not PlayerHRP or not LocalHRP then return end
	
	local Attachment0 = Instance.new("Attachment")
	Attachment0.Parent = LocalHRP
	
	local Attachment1 = Instance.new("Attachment")
	Attachment1.Parent = PlayerHRP
	
	local Beam = Instance.new("Beam")
	Beam.Attachment0 = Attachment0
	Beam.Attachment1 = Attachment1
	Beam.Color = ColorSequence.new(EspConfig.TracerColor)
	Beam.Width0 = EspConfig.TracerThickness
	Beam.Width1 = EspConfig.TracerThickness
	Beam.FaceCamera = true
	Beam.Parent = PlayerHRP
	
	EspState.TracerBeams[Plr] = {
		Beam = Beam,
		Start = Attachment0,
		End = Attachment1
	}
end

local function RemoveTracerBeam(Plr)
	local Data = EspState.TracerBeams[Plr]
	if Data then
		if Data.Beam then Data.Beam:Destroy() end
		if Data.Start then Data.Start:Destroy() end
		if Data.End then Data.End:Destroy() end
		EspState.TracerBeams[Plr] = nil
	end
end

local function UpdatePlayerEsp(Plr)
	if not EspState.Enabled then return end
	local Character = Plr.Character
	if not Character then return end
	
	if EspState.TeamCheck and Plr.Team == LocalPlayer.Team then
		RemoveHighlight(Character)
		RemoveEspName(Character)
		RemoveTracerBeam(Plr)
		return
	end
	
	CreateHighlight(Character, EspConfig.EnemyColor)
	if EspState.NamesEnabled then
		CreateEspName(Character, Plr.Name)
	else
		RemoveEspName(Character)
	end
	
	if EspState.TracerEnabled then
		CreateTracerBeam(Plr)
	else
		RemoveTracerBeam(Plr)
	end
end

local function RemovePlayerEsp(Plr)
	if Plr.Character then
		RemoveHighlight(Plr.Character)
		RemoveEspName(Plr.Character)
	end
	RemoveTracerBeam(Plr)
end

local function RefreshAllEsp()
	for _, Plr in ipairs(Players:GetPlayers()) do
		if Plr ~= LocalPlayer then
			if EspState.Enabled then
				UpdatePlayerEsp(Plr)
			else
				RemovePlayerEsp(Plr)
			end
		end
	end
end

