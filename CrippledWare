local HitboxBox = Tabs.Character:AddRightGroupbox("Hitbox Expander", "box")

local HitboxState = {
	Enabled = false,
	Hitboxes = {},
	Size = 1,
	Transparency = 0.5,
	TeamCheck = true
}

local function CreateHitbox(Character, Size, Transparency)
	local HRP = Character:FindFirstChild("HumanoidRootPart")
	if not HRP then return end
	
	if HitboxState.Hitboxes[Character] then
		HitboxState.Hitboxes[Character]:Destroy()
	end
	
	local Hitbox = Instance.new("Part")
	Hitbox.Name = "ExpandedHitbox"
	Hitbox.Shape = Enum.PartType.Block
	Hitbox.Material = Enum.Material.Neon
	Hitbox.CanCollide = false
	Hitbox.CFrame = HRP.CFrame
	Hitbox.Size = HRP.Size * Size
	Hitbox.Transparency = Transparency
	Hitbox.Color = Color3.fromRGB(0, 100, 255)
	Hitbox.Parent = HRP
	
	HitboxState.Hitboxes[Character] = Hitbox
	
	local Weld = Instance.new("WeldConstraint")
	Weld.Part0 = HRP
	Weld.Part1 = Hitbox
	Weld.Parent = Hitbox
end

local function RemoveHitbox(Character)
	if HitboxState.Hitboxes[Character] then
		HitboxState.Hitboxes[Character]:Destroy()
		HitboxState.Hitboxes[Character] = nil
	end
end

local function UpdateAllHitboxes()
	for _, Plr in ipairs(Players:GetPlayers()) do
		if Plr ~= LocalPlayer then
			local Character = Plr.Character
			if Character then
				if HitboxState.Enabled then
					if HitboxState.TeamCheck and Plr.Team == LocalPlayer.Team then
						RemoveHitbox(Character)
					else
						CreateHitbox(Character, HitboxState.Size, HitboxState.Transparency)
					end
				else
					RemoveHitbox(Character)
				end
			end
		end
	end
end

