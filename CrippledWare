local function resetHitbox(hrp)
	if not hrp or not hrp.Parent then return end
	hrp.Size = Vector3.new(2, 2, 1)
	hrp.Transparency = 1
	hrp.CanCollide = false
	hrp.Material = Enum.Material.Plastic
	hrp.Shape = Enum.PartType.Block
end

local function applyHitbox(plr)
	if plr == LocalPlayer then return end
	local char = plr.Character
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	local humanoid = char:FindFirstChildOfClass("Humanoid")
	local isSeated = humanoid and (humanoid.Sit or humanoid.SeatPart ~= nil)

	if isSeated then
		if hitboxModified[hrp] then
			resetHitbox(hrp)
			hitboxModified[hrp] = nil
		end
		return
	end

	if getgenv().HitboxSettings.HitboxTeamCheck and LocalPlayer.Team and plr.Team == LocalPlayer.Team then
		if hitboxModified[hrp] then
			resetHitbox(hrp)
			hitboxModified[hrp] = nil
		end
		return
	end

	local size = getgenv().HitboxSettings.HitboxSize or 1
	hrp.Size = Vector3.new(size, size, size)
	hrp.Transparency = getgenv().HitboxSettings.HitboxTransparency or 0.5
	hrp.CanCollide = false
	hrp.Material = Enum.Material.ForceField
	hrp.Shape = (getgenv().HitboxSettings.HitboxShape == "Ball") and Enum.PartType.Ball or Enum.PartType.Block

	hitboxModified[hrp] = true
end

game:GetService("RunService").Heartbeat:Connect(function()
	if not getgenv().HitboxSettings.HitboxExpanderEnabled then
		for hrp in pairs(hitboxModified) do
