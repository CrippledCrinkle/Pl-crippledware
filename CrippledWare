}

local function CreateHitbox(Character, Size, Transparency)
	if not Character then return end
	local HRP = Character:FindFirstChild("HumanoidRootPart")
	if not HRP then return end
	
	-- Remove existing hitbox
	if HitboxState.Hitboxes[Character] then
		HitboxState.Hitboxes[Character]:Destroy()
	end
	
	local Hitbox = Instance.new("Part")
	Hitbox.Name = "ExpandedHitbox"
	Hitbox.Shape = Enum.PartType.Block
	Hitbox.Material = Enum.Material.Neon
	Hitbox.CanCollide = false
	Hitbox.CFrame = HRP.CFrame
	Hitbox.Size = HRP.Size * Size
	Hitbox.Transparency = Transparency
	Hitbox.Color = COLORS.HITBOX
	Hitbox.Parent = HRP
	
	HitboxState.Hitboxes[Character] = Hitbox
	
	local Weld = Instance.new("WeldConstraint")
	Weld.Part0 = HRP
	Weld.Part1 = Hitbox
	Weld.Parent = Hitbox
end

local function RemoveHitbox(Character)
	if not Character then return end
	if HitboxState.Hitboxes[Character] then
		pcall(function() HitboxState.Hitboxes[Character]:Destroy() end)
		HitboxState.Hitboxes[Character] = nil
	end
end

local function UpdateAllHitboxes()
	for _, Plr in ipairs(Players:GetPlayers()) do
		if Plr ~= LocalPlayer and Plr.Character then
			if HitboxState.Enabled then
				if HitboxState.TeamCheck and Plr.Team == LocalPlayer.Team then
					RemoveHitbox(Plr.Character)
				else
					CreateHitbox(Plr.Character, HitboxState.Size, HitboxState.Transparency)
				end
			else
				RemoveHitbox(Plr.Character)
			end
		end
	end
end

