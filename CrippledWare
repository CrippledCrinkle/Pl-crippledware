game:GetService("RunService").RenderStepped:Connect(function()
	if EspState.TracerEnabled and EspState.Enabled then
		for _, Plr in ipairs(Players:GetPlayers()) do
			if Plr ~= LocalPlayer and Plr.Character then
				if not (EspState.TeamCheck and Plr.Team == LocalPlayer.Team) then
					if EspState.TracerBeams[Plr] then
						local Data = EspState.TracerBeams[Plr]
						if Data.Start.Parent ~= Plr.Character:FindFirstChild("HumanoidRootPart") or Data.End.Parent ~= LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
							RemoveTracerBeam(Plr)
						end
					else
						CreateTracerBeam(Plr)
					end
				end
			end
		end
	end
end)

